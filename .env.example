# Custom health check message
PING_MESSAGE=pong

# Supabase Auth (public values; the same names are set on Render)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase service role key, used only to save verified Gemini analysis attempts. Never prefix with VITE_ or NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Mapbox public token (must start with pk.). Restrict it to your app's URLs in the Mapbox dashboard.
VITE_MAPBOX_ACCESS_TOKEN=

# Google Gemini photo analysis. Server-only: never prefix these with VITE_ or NEXT_PUBLIC_.
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.8-flash.
GEMINI_MODEL=

# Skip login/signup (local dev / preview only)
# AUTH_DISABLED=true
